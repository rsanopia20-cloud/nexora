ADMIN_PASSWORD=replace_with_admin_password

# Production (Vercel) notes:
# CLIENT_URL and HOMEPAGE_URL = frontend URL (https://your-frontend.vercel.app)
# BASE_URL = backend URL (https://your-backend.vercel.app)
# NODE_ENV=production
# VITE_API_URL is a FRONTEND env var, not backend
